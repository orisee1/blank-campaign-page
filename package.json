{
  "name": "central-de-campanha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && electron electron/main.cjs",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.8.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.centralcampanha.desktop",
    "productName": "Central de Campanha",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "overrides": { "uuid": "^11.1.1" }
}
